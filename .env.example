# ============================================================
#  Variables del SITIO WEB (proyecto "APP Logistics Website")
#
#  En producción NO se sube este archivo con valores reales:
#  cada variable se pega en Railway → servicio del WEBSITE → "Variables".
#  Copia este archivo a `.env` para desarrollo local.
# ============================================================

# ───────── Canal de respaldo por correo (doble canal) ─────────
# El servidor del sitio envía un correo de respaldo directo cada vez que alguien
# llena un formulario, además de reenviarlo a RASTREO. Así, si RASTREO está
# caído, el equipo IGUAL recibe el aviso y no se pierde el lead.
#
# Sin RESEND_API_KEY el correo de respaldo NO se envía (pero el reenvío a
# RASTREO sigue funcionando). Puedes usar la MISMA clave que ya tienes en el
# proyecto RASTREO. Consíguela en https://resend.com → API Keys (empieza por "re_").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente del correo de respaldo. ⚠️ El dominio después del @ DEBE estar
# verificado en Resend (el mismo que ya verificaste).
EMAIL_FROM=APP Logistics <no-reply@app-logistics.com>

# Bandeja(s) que reciben el aviso de respaldo. Separar varios por coma.
# Si se deja vacío, usa info@applogistics.com.co por defecto.
NOTIFY_EMAIL=info@applogistics.com.co,info@im3systems.com

# ───────── 🚫 NO LAS PONGAS A MANO ─────────
# Railway inyecta PORT automáticamente, y NODE_ENV=production lo pone el arranque.
# PORT=
# NODE_ENV=production
